<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_services"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="12dp"
            android:text="MCP 服务" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_mcp_switch"
            style="@style/Widget.Simpfun.Settings.Item"
            android:clickable="false"
            android:focusable="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.Single">

            <include
                android:id="@+id/row_mcp"
                layout="@layout/view_settings_toggle_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_mcp_port"
            style="@style/Widget.Simpfun.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="监听端口"
            app:helperText="1025–65535"
            app:startIconDrawable="@drawable/ic_settings_ethernet">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_mcp_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="8090" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mcp_url"
            style="@style/Widget.Simpfun.Settings.InfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/colorTertiaryContainer"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务地址已就绪"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/tv_mcp_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineHeight="20sp"
                    android:text="http://…/mcp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="点按复制完整地址到剪贴板"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="工具" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_troubleshoot"
            style="@style/Widget.Simpfun.Settings.Item"
            android:clickable="true"
            android:focusable="true"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.First">

            <include
                android:id="@+id/row_troubleshoot"
                layout="@layout/view_settings_entry_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_quick_commands"
            style="@style/Widget.Simpfun.Settings.Item"
            android:layout_marginTop="3dp"
            android:clickable="true"
            android:focusable="true"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.Last">

            <include
                android:id="@+id/row_quick_commands"
                layout="@layout/view_settings_entry_row" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
