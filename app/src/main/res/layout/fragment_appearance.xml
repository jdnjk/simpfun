<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_appearance"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="12dp"
            android:text="应用外观" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dropdown_theme"
            style="@style/Widget.Simpfun.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="应用主题"
            app:startIconDrawable="@drawable/ic_brightness_6">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actv_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="跟随系统" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dropdown_terminal_color"
            style="@style/Widget.Simpfun.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="终端颜色"
            app:startIconDrawable="@drawable/ic_terminal">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actv_terminal_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="跟随应用主题" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_font_size_header"
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="终端字体大小 · 16sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_terminal_font_size"
            style="@style/Widget.Simpfun.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1.0"
            android:value="16.0"
            android:valueFrom="10.0"
            android:valueTo="24.0" />

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="服务器总览" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Simpfun.Settings.Item"
            android:clickable="false"
            android:focusable="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.First">

            <include
                android:id="@+id/row_server_card"
                layout="@layout/view_settings_toggle_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_cpu_limit"
            style="@style/Widget.Simpfun.Settings.Item"
            android:layout_marginTop="3dp"
            android:clickable="false"
            android:focusable="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.Middle">

            <include
                android:id="@+id/row_cpu_limit"
                layout="@layout/view_settings_toggle_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_line_chart"
            style="@style/Widget.Simpfun.Settings.Item"
            android:layout_marginTop="3dp"
            android:clickable="false"
            android:focusable="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.Last">

            <include
                android:id="@+id/row_line_chart"
                layout="@layout/view_settings_toggle_row" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
