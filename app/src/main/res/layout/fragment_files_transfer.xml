<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_files"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="12dp"
            android:text="文件浏览" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Simpfun.Settings.Item"
            android:clickable="false"
            android:focusable="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Simpfun.Item.Single">

            <include
                android:id="@+id/row_dual_pane"
                layout="@layout/view_settings_toggle_row" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dropdown_download_location"
            style="@style/Widget.Simpfun.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="下载保存位置"
            app:startIconDrawable="@drawable/ic_download_24">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actv_download_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="系统下载目录" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.Simpfun.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:text="SFTP 传输" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_sftp_thread_count"
            style="@style/Widget.Simpfun.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1.0"
            android:value="6.0"
            android:valueFrom="1.0"
            android:valueTo="32.0" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_sftp_thread_count"
            style="@style/Widget.Simpfun.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="传输线程数"
            app:helperText="1–32，推荐保持 6"
            app:startIconDrawable="@drawable/ic_tune">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_sftp_thread_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Simpfun.Settings.InfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="传输性能提示"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineHeight="20sp"
                    android:text="较高并发可改善高延迟网络速度，但可能增加服务器和设备负载。"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSecondaryContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
