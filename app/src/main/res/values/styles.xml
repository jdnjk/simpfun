<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Use MD2 by default for better compatibility on older Android versions. -->
    <style name="ThemeOverlay.Simpfun.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog" />

    <style name="FileActionText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SimpfunAppleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="SimpfunAppleShapeSmall" parent="SimpfunAppleShape">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="SimpfunAppleShapeMedium" parent="SimpfunAppleShape">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="SimpfunAppleShapeLarge" parent="SimpfunAppleShape">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Simpfun.Apple.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/apple_surfaceContainerLow</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/apple_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Simpfun.Apple.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/apple_surfaceContainerLow</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/apple_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Simpfun.Apple.CardView.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/apple_surfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/apple_outlineVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>
